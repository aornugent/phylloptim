# NB: R has no comment syntax for this file -- every line is a Perl regex, and a
# line like this one is simply a pattern that never matches anything. Keep the
# prose free of regex metacharacters: an unbalanced bracket here aborts
# R CMD build with "invalid regular expression", which is how this note came to
# be written.

# R excludes a .git DIRECTORY automatically, which covers a normal clone. In a
# git worktree .git is a 79-byte FILE pointing at the real gitdir, the automatic
# exclusion does not match it, and it ships silently -- one NOTE, and a tarball
# carrying a path into someone's filesystem. Costs nothing in a normal clone.
^\.git$
^\.github$
^\.claude$
^\.vscode$
^.*\.Rproj$
^\.Rproj\.user$
^COMPARISON\.md$
^agents\.md$

# Working notes for whoever picks up an item next -- the same class of thing as
# PLAN.md above, and flagged as a non-standard top-level directory if shipped.
# Added after notes/trait-gradients-seed.md arrived and put a NOTE in the check.
^notes$
^Doxyfile$
^docs$
^phylloptim_.+\.tar\.gz$
^.*\.Rcheck$

# The full AGPL text. R CMD check --as-cran flags it as a non-standard top-level
# file, because a LICENSE file is only expected when DESCRIPTION says
# "License: ... + file LICENSE"; ours names AGPL (>= 3) outright, so R already
# knows the terms and the copy here is for GitHub's benefit, not R's.
^LICENSE\.md$

# The developer harnesses, deliberately not shipped. R CMD check scans every
# Makefile in the tarball and warns about GNU extensions, and the sanctioned way
# to silence that -- SystemRequirements: GNU make -- would be a false statement
# about this package: installing it needs no make at all. tests/cpp.R compiles
# the two sources directly instead. See the long note at the top of that file.
# The top-level Makefile is developer entry points only, for the same reason.
^Makefile$
^tests/cpp/Makefile$

# Built by make -C tests/cpp. The sources and ALL THREE golden files must ship --
# the check in tests/cpp.R compiles and runs them -- but the binaries must not.
^tests/cpp/test_leaf$
^tests/cpp/test_golden$
^tests/cpp/test_primitives$
^tests/cpp/bench_solve$
^tests/cpp/bench_gradient$
^tests/cpp/.*\.dSYM$

# Validation scripts, not tests: they need an installed plant and take minutes.
# See the header comment in each.
^tests/validate$

# The CMake build, which exists so that "the model does not need R" is runnable
# rather than merely claimed (see README, "Use from C++"). It is for consumers
# who are not installing this as an R package, so it has no business in the
# tarball -- and R CMD check would flag the top-level CMakeLists.txt as a
# non-standard file if it were there.
^CMakeLists\.txt$
^cmake$
^build.*$
^_deps$

