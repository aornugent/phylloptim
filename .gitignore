# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
..Rcheck/
*.Rcheck/
*.tar.gz

# plot_model_overview() written out by hand, as vignette("the-models") suggests
overview.pdf

# C++ / test harness. The binaries under tests/cpp/ are ignored beside themselves,
# in tests/cpp/.gitignore, so that one list matches what the Makefile builds.
*.o
*.so
*.dylib

# macOS
.DS_Store
._*
.AppleDouble

# CMake, for the no-R build (see CMakeLists.txt)
build*/
CMakeCache.txt
CMakeFiles/

# Doxygen output (generated; see Doxyfile)
docs/

# Agent worktrees. A worktree checked out here records as a gitlink with no
# .gitmodules entry, which clones as an empty directory nothing can populate.
.claude/worktrees/
